-from simple_knn._C import distCUDA2
+try:
+    from simple_knn._C import distCUDA2
+except ImportError:
+    def distCUDA2(points):
+        """CPU fallback for environments where the legacy CUDA KNN extension is unavailable."""
+
+        from scipy.spatial import cKDTree
+
+        points_cpu = points.detach().float().cpu().numpy()
+        if points_cpu.shape[0] < 2:
+            return torch.full(
+                (points_cpu.shape[0],),
+                1.0e-7,
+                device=points.device,
+                dtype=points.dtype,
+            )
+        distances, _ = cKDTree(points_cpu).query(points_cpu, k=2, workers=-1)
+        squared = torch.from_numpy(distances[:, 1] ** 2)
+        return squared.to(device=points.device, dtype=points.dtype)
